NF179.internal_consistency : M6.PA.theory ⊢ ∼NF179.H179 🡒 M6.PA.consistencySentence
NF179.pa_cannot_prove_nonhalting_of_consistent (h : M6.PA.Consistent) : M6.PA.theory ⊬ ∼NF179.H179
NF179.pa_independence (nf : FFL.Entailment.Consistent 𝗡𝗙) :
  M6.PA.theory ⊬ ∼NF179.H179 ∧
    M6.PA.theory ⊬ NF179.H179 ∧
      ∀ (k : ℕ),
        M6.PA.theory ⊬ PA192.BusyBeaver.upper 179 k ∧
          M6.PA.theory ⊬ PA192.BusyBeaver.fixedUpper 0 k ∧ M6.PA.theory ⊬ PA192.BusyBeaver.value 179 k
NF179.true_value_independent (nf : FFL.Entailment.Consistent 𝗡𝗙) :
  ∃ k,
    (FFL.FirstOrder.Semiformula.Evalb ![]) (PA192.BusyBeaver.value 179 k) ∧
      M6.PA.theory ⊬ PA192.BusyBeaver.value 179 k ∧ M6.PA.theory ⊬ ∼PA192.BusyBeaver.value 179 k
