end Model

/-- The clause `e1` of the axioms N. -/
def nsatC_e1 (τ : ℕ) (q : BTm) : BFml :=
  (.all 100 (BFml.imp (.le (.add (BTm.aEq (.var 100) (.var 100)) .one) q) (.mem (BTm.aEq (.var 100) (.var 100)) τ)))

