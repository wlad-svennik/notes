  unfold fTwSpec fGraph2 TwSpec
  simp [Sat, M.sat_imp, M.sat_ex, M.sat_fApp3', M.sat_fApp',
    M.sat_fSucc (s := 12) (k := 9) (y := 26) (x := 27) (b := 28) (z := 29) (by decide)
      (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
      (by decide) (by decide),
    M.sat_fSucc (s := 18) (k := 10) (y := 26) (x := 27) (b := 28) (z := 29) (by decide)
