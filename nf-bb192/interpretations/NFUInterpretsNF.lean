import NFUTerm

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option linter.unusedSectionVars false



/-!
# Phase 3, part 1: the interpretation is given by formulas of a two-sorted arithmetic language

The language `L₂` has number terms built from variables, `0`, `1`, numerals, `+` and `·`;
atomic formulas `s = t`, `s ≤ t`, `t ∈ X` for a set variable `X`, and `t ∈ 𝖪ₜ`; and quantifiers
over numbers and over sets. The domain `InI`, the membership `Eps` and the equality `Eta` of
the term model are given by formulas of `L₂` (`delta2`, `eps2`, `eta2`). The part about the
axioms N is generated by `gen/genS6.py`.
-/

namespace NFUCut

/-- Number terms of `L₂`. -/
inductive BTm : Type
  | var (i : ℕ) : BTm
  | zero : BTm
  | one : BTm
  | lit (n : ℕ) : BTm
  | add (s t : BTm) : BTm
  | mul (s t : BTm) : BTm

/-- Formulas of `L₂`. -/
inductive BFml : Type
  | eq (s t : BTm) : BFml
  | le (s t : BTm) : BFml
  | mem (t : BTm) (X : ℕ) : BFml
  | inKt (t : BTm) : BFml
  | neg (φ : BFml) : BFml
  | and (φ ψ : BFml) : BFml
  | all (x : ℕ) (φ : BFml) : BFml
  | allS (X : ℕ) (φ : BFml) : BFml

namespace BFml

def or (φ ψ : BFml) : BFml := neg (and (neg φ) (neg ψ))
def imp (φ ψ : BFml) : BFml := neg (and φ (neg ψ))
def iff (φ ψ : BFml) : BFml := and (imp φ ψ) (imp ψ φ)
def exS (X : ℕ) (φ : BFml) : BFml := neg (allS X (neg φ))

end BFml

namespace BTm

def npair (s t : BTm) : BTm := add (mul (add s t) (add s t)) s
def tm (f : ℕ) (s t : BTm) : BTm := add (npair (lit f) (npair s t)) one
def aIn (s t : BTm) : BTm := add (npair s t) (npair s t)
def aEq (s t : BTm) : BTm := add (add (npair s t) (npair s t)) one
def sgT (x : BTm) : BTm := tm 0 x .zero
def upT (x y : BTm) : BTm := tm 1 x y
def inT (x y : BTm) : BTm := tm 2 x y
def coT (x : BTm) : BTm := tm 3 x .zero
def siT (x : BTm) : BTm := tm 4 x .zero
def i2T (x : BTm) : BTm := tm 5 x .zero
def i3T (x : BTm) : BTm := tm 6 x .zero
def vcT (x : BTm) : BTm := tm 7 x .zero
def tlT (x : BTm) : BTm := tm 8 x .zero
def cvT (x : BTm) : BTm := tm 9 x .zero
def dT (x y : BTm) : BTm := tm 12 x y
def p1T (x : BTm) : BTm := tm 13 x .zero
def p2T (x : BTm) : BTm := tm 14 x .zero
def elT (x : BTm) : BTm := tm 15 x .zero
def wtT (x y : BTm) : BTm := tm 16 x y
def wsT (x y : BTm) : BTm := tm 17 x y
def opT (x y : BTm) : BTm := upT (sgT x) (upT x y)
def c1T : BTm := tm 10 .zero .zero
def sbT : BTm := tm 11 .zero .zero

end BTm

namespace Model

variable {V : Type} [Nonempty V] (M : Model V) [hinf : Fact M.Infinity]

/-- The value of a number term. -/
noncomputable def evalT : BTm → (ℕ → M.Num) → M.Num
  | .var i, e => e i
  | .zero, _ => 0
  | .one, _ => 1
  | .lit n, _ => (n : M.Num)
  | .add s t, e => evalT s e + evalT t e
  | .mul s t, e => evalT s e * evalT t e

/-- Truth of a formula of `L₂`; the set variables range over all objects of the model. -/
def bholds : BFml → (ℕ → M.Num) → (ℕ → V) → Prop
  | .eq s t, e, _ => M.evalT s e = M.evalT t e
  | .le s t, e, _ => M.evalT s e ≤ M.evalT t e
  | .mem t X, e, s => M.mem (M.evalT t e).1 (s X)
  | .inKt t, e, _ => M.InKt (M.evalT t e)
  | .neg φ, e, s => ¬ bholds φ e s
  | .and φ ψ, e, s => bholds φ e s ∧ bholds ψ e s
  | .all x φ, e, s => ∀ a : M.Num, bholds φ (Function.update e x a) s
  | .allS X φ, e, s => ∀ A : V, bholds φ e (Function.update s X A)

theorem bholds_imp {φ ψ : BFml} {e : ℕ → M.Num} {s : ℕ → V} :
    M.bholds (φ.imp ψ) e s ↔ (M.bholds φ e s → M.bholds ψ e s) := by
  simp only [BFml.imp, bholds]
  tauto

theorem bholds_or {φ ψ : BFml} {e : ℕ → M.Num} {s : ℕ → V} :
    M.bholds (φ.or ψ) e s ↔ (M.bholds φ e s ∨ M.bholds ψ e s) := by
  simp only [BFml.or, bholds]
  tauto

theorem bholds_iff {φ ψ : BFml} {e : ℕ → M.Num} {s : ℕ → V} :
    M.bholds (φ.iff ψ) e s ↔ (M.bholds φ e s ↔ M.bholds ψ e s) := by
  simp only [BFml.iff, BFml.imp, bholds]
  tauto

theorem bholds_exS {X : ℕ} {φ : BFml} {e : ℕ → M.Num} {s : ℕ → V} :
    M.bholds (φ.exS X) e s ↔ ∃ A : V, M.bholds φ e (Function.update s X A) := by
  simp only [BFml.exS, bholds]
  exact not_forall_not

