/-!
# Phase 3, part 10: NFU + Infinity interprets NF

`nfDelta`, `nfEps`, `nfEta` are formulas of the language of NFU (membership, equality,
"is a set") without parameters. In every model of NFU + Infinity, the objects that satisfy
`nfDelta`, with `nfEps` as membership and modulo `nfEta`, form a model of NF.
-/

namespace NFUCut

/-- The conjunction of the characterisations of the parameters `1`–`7`. -/
def parF : Fml :=
  .and isZ (.and isNat (.and isOne (.and fAddSpec (.and fMulSpec (.and fExpSpec fTwSpec)))))

/-- The formula with the parameters `1`–`7` quantified away. -/
def closeP (φ : Fml) : Fml :=
  Fml.ex 1 (Fml.ex 2 (Fml.ex 3 (Fml.ex 4 (Fml.ex 5 (Fml.ex 6 (Fml.ex 7 (.and parF φ)))))))

/-- **The domain of the interpretation**: a formula in the variable `100`. -/
def nfDelta : Fml := closeP (.and (.mem 100 2) (trB delta2))

/-- **The membership of the interpretation**: a formula in the variables `100` and `103`. -/
def nfEps : Fml := closeP (.and (.mem 100 2) (.and (.mem 103 2) (trB eps2)))

/-- **The equality of the interpretation**: a formula in the variables `100` and `103`. -/
def nfEta : Fml := closeP (.and (.mem 100 2) (.and (.mem 103 2) (trB eta2)))

/-- The environment with the values of the parameters. -/
def parEnv {V : Type} (ρ : ℕ → V) (z N A Mu o Tw Ex : V) : ℕ → V :=
  Function.update (Function.update (Function.update (Function.update (Function.update
    (Function.update (Function.update ρ 1 z) 2 N) 3 A) 4 Mu) 5 o) 6 Tw) 7 Ex

theorem parEnv_ge {V : Type} (ρ : ℕ → V) (z N A Mu o Tw Ex : V) {n : ℕ} (hn : 8 ≤ n) :
    parEnv ρ z N A Mu o Tw Ex n = ρ n := by
  unfold parEnv
  rw [Function.update_of_ne (by omega), Function.update_of_ne (by omega),
    Function.update_of_ne (by omega), Function.update_of_ne (by omega),
    Function.update_of_ne (by omega), Function.update_of_ne (by omega),
    Function.update_of_ne (by omega)]

namespace Model

variable {V : Type} [Nonempty V] (M : Model V) [hinf : Fact M.Infinity]

/-- The parameters have their intended values. -/
def ParOK (ρ : ℕ → V) : Prop :=
  ρ 1 = M.zero ∧ ρ 2 = M.nat ∧ ρ 5 = (1 : M.Num).1 ∧ M.IsGraphOf₂ (ρ 3) M.addN ∧
    M.IsGraphOf₂ (ρ 4) M.mulN ∧ M.IsGraphOf (ρ 7) M.expN ∧ M.IsGraphOf (ρ 6) M.tw

theorem sat_parF (ρ : ℕ → V) : Sat M.mem M.isSet parF ρ ↔ M.ParOK ρ := by
  unfold parF ParOK
  simp only [Sat]
  constructor
  · rintro ⟨hz, hn, ho, ha, hm, he, ht⟩
    have h1 := (M.sat_isZ ρ).mp hz
    have h2 := (M.sat_isNat ρ h1).mp hn
    have h5 : ρ 5 = (1 : M.Num).1 := by
      rw [(M.sat_isOne ρ).mp ho, h1]
      rfl
    have hA := M.addSpec_iff.mp ((M.sat_fAddSpec ρ h1 h2).mp ha)
    have hMu := (M.mulSpec_iff hA).mp ((M.sat_fMulSpec ρ h1 h2).mp hm)
    have hEx := (M.expSpec_iff hA).mp ((M.sat_fExpSpec ρ h1 h2).mp he)
    have hTw := (M.twSpec_iff hA hMu hEx).mp ((M.sat_fTwSpec ρ h1 h2).mp ht)
    exact ⟨h1, h2, h5, hA, hMu, hEx, hTw⟩
  · rintro ⟨h1, h2, h5, hA, hMu, hEx, hTw⟩
    refine ⟨(M.sat_isZ ρ).mpr h1, (M.sat_isNat ρ h1).mpr h2, (M.sat_isOne ρ).mpr ?_,
      (M.sat_fAddSpec ρ h1 h2).mpr (M.addSpec_iff.mpr hA),
      (M.sat_fMulSpec ρ h1 h2).mpr ((M.mulSpec_iff hA).mpr hMu),
      (M.sat_fExpSpec ρ h1 h2).mpr ((M.expSpec_iff hA).mpr hEx),
      (M.sat_fTwSpec ρ h1 h2).mpr ((M.twSpec_iff hA hMu hEx).mpr hTw)⟩
    rw [h5, h1]
    rfl

theorem sat_closeP (φ : Fml) (ρ : ℕ → V) : Sat M.mem M.isSet (closeP φ) ρ ↔
    ∃ z N A Mu o Tw Ex, M.ParOK (parEnv ρ z N A Mu o Tw Ex) ∧
      Sat M.mem M.isSet φ (parEnv ρ z N A Mu o Tw Ex) := by
  unfold closeP parEnv
  simp only [M.sat_ex, Sat, M.sat_parF]

/-- The parameters exist. -/
theorem exists_par (ρ : ℕ → V) : ∃ z N A Mu o Tw Ex, M.ParOK (parEnv ρ z N A Mu o Tw Ex) := by
  obtain ⟨A, hA⟩ := M.addN_natOp
  obtain ⟨Mu, hMu⟩ := M.mulN_natOp
  obtain ⟨Ex, hEx⟩ := M.natFn_expN
  obtain ⟨Tw, hTw⟩ := M.natFn_tw
  refine ⟨M.zero, M.nat, A, Mu, (1 : M.Num).1, Tw, Ex, ?_⟩
  unfold ParOK parEnv
  simp only [Function.update_apply]
  exact ⟨by simp, by simp, by simp, by simpa using hA, by simpa using hMu, by simpa using hEx,
    by simpa using hTw⟩

/-- The translation of a formula of `L₂`, evaluated with the intended parameters. -/
theorem sat_trB_par (ψ : BFml) (ρ' : ℕ → V) (hP : M.ParOK ρ') (e : ℕ → M.Num) (s : ℕ → V)
    (hn : ∀ i, ρ' (nv i) = (e i).1) (hs : ∀ X, ρ' (sv X) = s X) :
    Sat M.mem M.isSet (trB ψ) ρ' ↔ M.bholds ψ e s :=
  M.sat_trB hP.2.2.2.1 hP.2.2.2.2.1 hP.2.2.2.2.2.2 ψ ρ' e s
    ⟨hP.1, hP.2.1, rfl, rfl, hP.2.2.1, rfl, hn, hs⟩

/-- **The formula `nfDelta` defines the cut of the terms.** -/
theorem sat_nfDelta (x : V) :
    Sat M.mem M.isSet nfDelta (fun _ => x) ↔ ∃ hx : M.mem x M.nat, M.InI ⟨x, hx⟩ := by
  unfold nfDelta
  rw [M.sat_closeP]
  have hnv : ∀ (z N A Mu o Tw Ex : V) (i : ℕ),
      parEnv (fun _ => x) z N A Mu o Tw Ex (nv i) = x := fun z N A Mu o Tw Ex i =>
    parEnv_ge _ _ _ _ _ _ _ _ (by unfold nv; omega)
  have hsv : ∀ (z N A Mu o Tw Ex : V) (X : ℕ),
      parEnv (fun _ => x) z N A Mu o Tw Ex (sv X) = x := fun z N A Mu o Tw Ex X =>
    parEnv_ge _ _ _ _ _ _ _ _ (by unfold sv; omega)
  constructor
  · rintro ⟨z, N, A, Mu, o, Tw, Ex, hP, hsat⟩
    simp only [Sat] at hsat
    obtain ⟨hmem, htr⟩ := hsat
    rw [show (100 : ℕ) = nv 0 from rfl, hnv, hP.2.1] at hmem
    refine ⟨hmem, ?_⟩
    rw [M.sat_trB_par delta2 _ hP (fun _ => ⟨x, hmem⟩) (fun _ => x)
      (fun i => hnv _ _ _ _ _ _ _ i) (fun X => hsv _ _ _ _ _ _ _ X)] at htr
    exact (M.bholds_delta2 _ _).mp htr
  · rintro ⟨hx, hI⟩
    obtain ⟨z, N, A, Mu, o, Tw, Ex, hP⟩ := M.exists_par (fun _ => x)
    refine ⟨z, N, A, Mu, o, Tw, Ex, hP, ?_⟩
    simp only [Sat]
    refine ⟨?_, ?_⟩
    · rw [show (100 : ℕ) = nv 0 from rfl, hnv, hP.2.1]
      exact hx
    · rw [M.sat_trB_par delta2 _ hP (fun _ => ⟨x, hx⟩) (fun _ => x)
        (fun i => hnv _ _ _ _ _ _ _ i) (fun X => hsv _ _ _ _ _ _ _ X)]
      exact (M.bholds_delta2 _ _).mpr hI

/-- The common part of the statements about `nfEps` and `nfEta`. -/
theorem sat_two (ψ : BFml) (P : M.Num → M.Num → Prop)
    (hψ : ∀ (e : ℕ → M.Num) (s : ℕ → V), M.bholds ψ e s ↔ P (e 0) (e 1)) (x y : V) :
    Sat M.mem M.isSet (closeP (.and (.mem 100 2) (.and (.mem 103 2) (trB ψ))))
      (Function.update (fun _ => x) 103 y) ↔
      ∃ (hx : M.mem x M.nat) (hy : M.mem y M.nat), P ⟨x, hx⟩ ⟨y, hy⟩ := by
  rw [M.sat_closeP]
  have h100 : ∀ (z N A Mu o Tw Ex : V),
      parEnv (Function.update (fun _ => x) 103 y) z N A Mu o Tw Ex 100 = x := by
    intro z N A Mu o Tw Ex
    rw [parEnv_ge _ _ _ _ _ _ _ _ (by norm_num), Function.update_of_ne (by decide)]
  have h103 : ∀ (z N A Mu o Tw Ex : V),
      parEnv (Function.update (fun _ => x) 103 y) z N A Mu o Tw Ex 103 = y := by
    intro z N A Mu o Tw Ex
    rw [parEnv_ge _ _ _ _ _ _ _ _ (by norm_num), Function.update_self]
  have hnv : ∀ (z N A Mu o Tw Ex : V) (hx : M.mem x M.nat) (hy : M.mem y M.nat) (i : ℕ),
      parEnv (Function.update (fun _ => x) 103 y) z N A Mu o Tw Ex (nv i) =
        (Function.update (fun _ => (⟨x, hx⟩ : M.Num)) 1 ⟨y, hy⟩ i).1 := by
    intro z N A Mu o Tw Ex hx hy i
    rw [parEnv_ge _ _ _ _ _ _ _ _ (by unfold nv; omega)]
    by_cases hi : i = 1
    · rw [hi, Function.update_self]
      exact Function.update_self _ _ _
    · rw [Function.update_of_ne hi, Function.update_of_ne (by unfold nv; omega)]
  have hsv : ∀ (z N A Mu o Tw Ex : V) (X : ℕ),
      parEnv (Function.update (fun _ => x) 103 y) z N A Mu o Tw Ex (sv X) = x := by
    intro z N A Mu o Tw Ex X
    rw [parEnv_ge _ _ _ _ _ _ _ _ (by unfold sv; omega),
      Function.update_of_ne (by unfold sv; omega)]
  constructor
  · rintro ⟨z, N, A, Mu, o, Tw, Ex, hP, hsat⟩
    simp only [Sat] at hsat
    obtain ⟨hmx, hmy, htr⟩ := hsat
    rw [h100, hP.2.1] at hmx
    rw [h103, hP.2.1] at hmy
    refine ⟨hmx, hmy, ?_⟩
    rw [M.sat_trB_par ψ _ hP (Function.update (fun _ => ⟨x, hmx⟩) 1 ⟨y, hmy⟩) (fun _ => x)
      (fun i => hnv _ _ _ _ _ _ _ hmx hmy i) (fun X => hsv _ _ _ _ _ _ _ X), hψ] at htr
    rw [Function.update_of_ne (by decide), Function.update_self] at htr
    exact htr
  · rintro ⟨hx, hy, hP'⟩
    obtain ⟨z, N, A, Mu, o, Tw, Ex, hP⟩ := M.exists_par (Function.update (fun _ => x) 103 y)
    refine ⟨z, N, A, Mu, o, Tw, Ex, hP, ?_⟩
    simp only [Sat]
    refine ⟨?_, ?_, ?_⟩
    · rw [h100, hP.2.1]
      exact hx
    · rw [h103, hP.2.1]
      exact hy
    · rw [M.sat_trB_par ψ _ hP (Function.update (fun _ => ⟨x, hx⟩) 1 ⟨y, hy⟩) (fun _ => x)
        (fun i => hnv _ _ _ _ _ _ _ hx hy i) (fun X => hsv _ _ _ _ _ _ _ X), hψ]
      rw [Function.update_of_ne (by decide), Function.update_self]
      exact hP'

/-- **The formula `nfEps` defines the membership of the term model.** -/
theorem sat_nfEps (x y : V) :
    Sat M.mem M.isSet nfEps (Function.update (fun _ => x) 103 y) ↔
      ∃ (hx : M.mem x M.nat) (hy : M.mem y M.nat), M.Eps ⟨x, hx⟩ ⟨y, hy⟩ :=
  M.sat_two eps2 M.Eps (fun e s => M.bholds_eps2 e s) x y

/-- **The formula `nfEta` defines the equality of the term model.** -/
theorem sat_nfEta (x y : V) :
    Sat M.mem M.isSet nfEta (Function.update (fun _ => x) 103 y) ↔
      ∃ (hx : M.mem x M.nat) (hy : M.mem y M.nat), M.Eta ⟨x, hx⟩ ⟨y, hy⟩ :=
  M.sat_two eta2 M.Eta (fun e s => M.bholds_eta2 e s) x y

end Model

/-- **NFU + Infinity interprets NF.** There are formulas `δ`, `ε`, `η` of the language of NFU,
without parameters and the same for all models, such that in every model of NFU + Infinity
the objects that satisfy `δ`, with the relation defined by `ε` and modulo the relation defined
by `η`, form a model of NF: there is a map `π` from these objects onto a structure `(W, mem)`
that satisfies extensionality and every instance of stratified comprehension, such that
`π x = π y` exactly when `η` holds of `x`, `y`, and `mem (π x) (π y)` exactly when `ε` holds
of `x`, `y`. (A formula is evaluated with `x` as the value of the variable `100`, `y` as the
value of the variable `103`, and `x` as the value of every other variable.) -/
theorem nfu_inf_interprets_nf :
    ∃ δ ε η : Fml, ∀ (V : Type) [Nonempty V] (M : Model V) [Fact M.Infinity],
      ∃ (W : Type) (mem : W → W → Prop)
        (π : {x : V // Sat M.mem M.isSet δ (fun _ => x)} → W),
        ConNF.NF.IsNF W mem ∧ Function.Surjective π ∧
        (∀ x y, π x = π y ↔ Sat M.mem M.isSet η (Function.update (fun _ => x.1) 103 y.1)) ∧
        (∀ x y, mem (π x) (π y) ↔
          Sat M.mem M.isSet ε (Function.update (fun _ => x.1) 103 y.1)) := by
  refine ⟨nfDelta, nfEps, nfEta, fun V _ M _ => ?_⟩
  have hd : ∀ x : {x : V // Sat M.mem M.isSet nfDelta (fun _ => x)},
      ∃ hx : M.mem x.1 M.nat, M.InI ⟨x.1, hx⟩ := fun x => (M.sat_nfDelta x.1).mp x.2
  refine ⟨M.NV, M.nmem, fun x => M.nmk ⟨⟨x.1, (hd x).fst⟩, (hd x).snd⟩, M.termModel_isNF,
    fun w => ?_, fun x y => ?_, fun x y => ?_⟩
  · obtain ⟨a, rfl⟩ := M.nmk_surj w
    exact ⟨⟨a.1.1, (M.sat_nfDelta a.1.1).mpr ⟨a.1.2, a.2⟩⟩, rfl⟩
  · rw [M.nmk_eq, M.sat_nfEta]
    exact ⟨fun h => ⟨(hd x).fst, (hd y).fst, h⟩, fun ⟨_, _, h⟩ => h⟩
  · rw [M.sat_nfEps]
    exact ⟨fun h => ⟨(hd x).fst, (hd y).fst, h⟩, fun ⟨_, _, h⟩ => h⟩

end NFUCut

