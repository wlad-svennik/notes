/-!
# Phase 3, part 2: the formulas of `L₂` for the domain, the membership and the equality

`delta2`, `eps2`, `eta2` are formulas of the two-sorted arithmetic language `L₂` with
`bholds delta2 e s ↔ InI (e 0)`, `bholds eps2 e s ↔ Eps (e 0) (e 1)` and
`bholds eta2 e s ↔ Eta (e 0) (e 1)`.
-/

namespace NFUCut

/-- Agreement of the set variables `S`, `S'` below `k`. -/
def agreeF (k : BTm) (S S' : ℕ) : BFml :=
  .all 110 (BFml.imp (.le (.add (.var 110) .one) k)
    (BFml.iff (.mem (.var 110) S) (.mem (.var 110) S')))

def sat1F (k : BTm) (S : ℕ) (q : BTm) : BFml :=
  BFml.exS 200 ((agreeF k 200 S).and (nsatF 200 q))

def goodF (k : BTm) (S : ℕ) : BFml :=
  .all 120 (BFml.imp (.inKt (.var 120)) (sat1F k S (.var 120)))

def t1F (k : BTm) (S : ℕ) : BFml :=
  BFml.exS 201 ((agreeF k 201 S).and ((BFml.mem k 201).and (goodF (.add k .one) 201)))

def correctF (k : BTm) (S : ℕ) : BFml :=
  (BFml.all 130 (BFml.imp (.le (.var 130) k) (goodF (.var 130) S))).and
    (.all 130 (BFml.imp (.le (.add (.var 130) .one) k)
      (BFml.iff (.mem (.var 130) S) (t1F (.var 130) S))))

def inJF (k : BTm) : BFml := (BFml.inKt k).and (BFml.exS 202 (correctF k 202))

def k1F (m : BTm) : BFml := .all 140 (BFml.imp (inJF (.var 140)) (inJF (.add (.var 140) m)))

def inIF (n : BTm) : BFml := .all 141 (BFml.imp (k1F (.var 141)) (k1F (.mul (.var 141) n)))

def epsF (t t' : BTm) : BFml :=
  BFml.exS 203 ((correctF (.add (BTm.aIn t t') .one) 203).and (.mem (BTm.aIn t t') 203))

def etaF (t t' : BTm) : BFml :=
  BFml.exS 203 ((correctF (.add (BTm.aEq t t') .one) 203).and (.mem (BTm.aEq t t') 203))

/-- The domain of the interpretation, as a formula of `L₂` in the number variable `0`. -/
def delta2 : BFml := inIF (.var 0)

/-- The membership of the interpretation, in the number variables `0` and `1`. -/
def eps2 : BFml := epsF (.var 0) (.var 1)

/-- The equality of the interpretation, in the number variables `0` and `1`. -/
def eta2 : BFml := etaF (.var 0) (.var 1)

namespace Model

variable {V : Type} [Nonempty V] (M : Model V) [hinf : Fact M.Infinity]

/-- The value of the term does not depend on the variable `i`. -/
def Fr (k : BTm) (i : ℕ) : Prop :=
  ∀ (e : ℕ → M.Num) (a : M.Num), M.evalT k (Function.update e i a) = M.evalT k e

theorem fr_var {j i : ℕ} (h : j ≠ i) : M.Fr (.var j) i := fun e a => by
  simp only [evalT]
  exact Function.update_of_ne h a e

theorem fr_one (i : ℕ) : M.Fr .one i := fun _ _ => rfl

theorem fr_add {s t : BTm} {i : ℕ} (hs : M.Fr s i) (ht : M.Fr t i) : M.Fr (.add s t) i :=
  fun e a => by
    simp only [evalT]
    rw [hs, ht]

theorem fr_mul {s t : BTm} {i : ℕ} (hs : M.Fr s i) (ht : M.Fr t i) : M.Fr (.mul s t) i :=
  fun e a => by
    simp only [evalT]
    rw [hs, ht]

theorem fr_aIn {s t : BTm} {i : ℕ} (hs : M.Fr s i) (ht : M.Fr t i) : M.Fr (BTm.aIn s t) i :=
  M.fr_add (M.fr_add (M.fr_mul (M.fr_add hs ht) (M.fr_add hs ht)) hs)
    (M.fr_add (M.fr_mul (M.fr_add hs ht) (M.fr_add hs ht)) hs)

theorem fr_aEq {s t : BTm} {i : ℕ} (hs : M.Fr s i) (ht : M.Fr t i) : M.Fr (BTm.aEq s t) i :=
  M.fr_add (M.fr_aIn hs ht) (M.fr_one i)

theorem bholds_agreeF (k : BTm) (S S' : ℕ) (e : ℕ → M.Num) (s : ℕ → V) (hk : M.Fr k 110) :
    M.bholds (agreeF k S S') e s ↔ M.Agree (M.evalT k e) (s S) (s S') := by
  unfold agreeF Agree
  simp only [bholds, M.bholds_imp, M.bholds_iff, evalT, Function.update_self, hk e]

theorem bholds_sat1F (k : BTm) (S : ℕ) (q : BTm) (e : ℕ → M.Num) (s : ℕ → V) (hS : S ≠ 200)
    (hk : M.Fr k 110) (hq : ∀ i, 100 ≤ i → i ≤ 108 → M.Fr q i) :
    M.bholds (sat1F k S q) e s ↔ M.Sat1 (M.evalT k e) (s S) (M.evalT q e) := by
  unfold sat1F Sat1
  rw [M.bholds_exS]
  refine exists_congr fun A => ?_
  simp only [bholds]
  rw [M.bholds_agreeF k 200 S e _ hk, M.bholds_nsatF 200 q e _ (fun e i a h1 h2 => hq i h1 h2 e a),
    Function.update_self, Function.update_of_ne hS]

theorem bholds_goodF (k : BTm) (S : ℕ) (e : ℕ → M.Num) (s : ℕ → V) (hS : S ≠ 200)
    (hk : M.Fr k 110) (hk' : M.Fr k 120) :
    M.bholds (goodF k S) e s ↔ M.Good (M.evalT k e) (s S) := by
  unfold goodF Good
  simp only [bholds, M.bholds_imp, evalT, Function.update_self]
  refine forall_congr' fun a => imp_congr Iff.rfl ?_
  rw [M.bholds_sat1F k S (.var 120) _ s hS hk
    (fun i h1 h2 => M.fr_var (by omega)), hk' e a]
  simp only [evalT, Function.update_self]

theorem bholds_t1F (k : BTm) (S : ℕ) (e : ℕ → M.Num) (s : ℕ → V) (hS : S ≠ 201)
    (hk : M.Fr k 110) (hk' : M.Fr k 120) :
    M.bholds (t1F k S) e s ↔ M.T1 (M.evalT k e) (s S) := by
  unfold t1F T1
  rw [M.bholds_exS]
  refine exists_congr fun A => ?_
  simp only [bholds]
  rw [M.bholds_agreeF k 201 S e _ hk, M.bholds_goodF (.add k .one) 201 e _ (by norm_num)
    (M.fr_add hk (M.fr_one _)) (M.fr_add hk' (M.fr_one _)),
    Function.update_self, Function.update_of_ne hS]
  simp only [evalT]

theorem bholds_correctF (k : BTm) (S : ℕ) (e : ℕ → M.Num) (s : ℕ → V) (hS : S ≠ 200)
    (hS' : S ≠ 201) (hk : M.Fr k 130) :
    M.bholds (correctF k S) e s ↔ M.Correct (M.evalT k e) (s S) := by
  unfold correctF Correct
  simp only [bholds, M.bholds_imp, M.bholds_iff, evalT, Function.update_self, hk e]
  refine and_congr (forall_congr' fun a => imp_congr Iff.rfl ?_)
    (forall_congr' fun a => imp_congr Iff.rfl (iff_congr Iff.rfl ?_))
  · rw [M.bholds_goodF (.var 130) S _ s hS (M.fr_var (by norm_num)) (M.fr_var (by norm_num))]
    simp only [evalT, Function.update_self]
  · rw [M.bholds_t1F (.var 130) S _ s hS' (M.fr_var (by norm_num)) (M.fr_var (by norm_num))]
    simp only [evalT, Function.update_self]

theorem bholds_inJF (k : BTm) (e : ℕ → M.Num) (s : ℕ → V) (hk : M.Fr k 130) :
    M.bholds (inJF k) e s ↔ M.InJ (M.evalT k e) := by
  unfold inJF InJ
  simp only [bholds]
  rw [M.bholds_exS]
  refine and_congr Iff.rfl (exists_congr fun A => ?_)
  rw [M.bholds_correctF k 202 e _ (by norm_num) (by norm_num) hk, Function.update_self]

theorem bholds_k1F (m : BTm) (e : ℕ → M.Num) (s : ℕ → V) (hm : M.Fr m 140) (hm' : M.Fr m 130) :
    M.bholds (k1F m) e s ↔ Shortening.K₁ M.InJ (fun n : M.Num => n) (M.evalT m e) := by
  unfold k1F Shortening.K₁ Shortening.C₂
  simp only [bholds, M.bholds_imp]
  refine forall_congr' fun a => ?_
  rw [M.bholds_inJF (.var 140) _ s (M.fr_var (by norm_num)),
    M.bholds_inJF (.add (.var 140) m) _ s (M.fr_add (M.fr_var (by norm_num)) hm')]
  simp only [evalT, Function.update_self, hm e a]

theorem bholds_inIF (n : BTm) (e : ℕ → M.Num) (s : ℕ → V) (hn : M.Fr n 141) (hn' : M.Fr n 140)
    (hn'' : M.Fr n 130) : M.bholds (inIF n) e s ↔ M.InI (M.evalT n e) := by
  unfold inIF InI Shortening.K
  simp only [bholds, M.bholds_imp]
  refine forall_congr' fun a => ?_
  rw [M.bholds_k1F (.var 141) _ s (M.fr_var (by norm_num)) (M.fr_var (by norm_num)),
    M.bholds_k1F (.mul (.var 141) n) _ s (M.fr_mul (M.fr_var (by norm_num)) hn')
      (M.fr_mul (M.fr_var (by norm_num)) hn'')]
  simp only [evalT, Function.update_self, hn e a]

theorem bholds_epsF (t t' : BTm) (e : ℕ → M.Num) (s : ℕ → V) (ht : M.Fr t 130)
    (ht' : M.Fr t' 130) : M.bholds (epsF t t') e s ↔ M.Eps (M.evalT t e) (M.evalT t' e) := by
  unfold epsF Eps
  rw [M.bholds_exS]
  refine exists_congr fun A => ?_
  simp only [bholds]
  rw [M.bholds_correctF (.add (BTm.aIn t t') .one) 203 e _ (by norm_num) (by norm_num)
    (M.fr_add (M.fr_aIn ht ht') (M.fr_one _)), Function.update_self]
  simp only [evalT, M.evalT_aIn]

theorem bholds_etaF (t t' : BTm) (e : ℕ → M.Num) (s : ℕ → V) (ht : M.Fr t 130)
    (ht' : M.Fr t' 130) : M.bholds (etaF t t') e s ↔ M.Eta (M.evalT t e) (M.evalT t' e) := by
  unfold etaF Eta
  rw [M.bholds_exS]
  refine exists_congr fun A => ?_
  simp only [bholds]
  rw [M.bholds_correctF (.add (BTm.aEq t t') .one) 203 e _ (by norm_num) (by norm_num)
    (M.fr_add (M.fr_aEq ht ht') (M.fr_one _)), Function.update_self]
  simp only [evalT, M.evalT_aEq]

/-- **The domain of the interpretation is given by a formula of `L₂`.** -/
theorem bholds_delta2 (e : ℕ → M.Num) (s : ℕ → V) : M.bholds delta2 e s ↔ M.InI (e 0) :=
  M.bholds_inIF (.var 0) e s (M.fr_var (by norm_num)) (M.fr_var (by norm_num))
    (M.fr_var (by norm_num))

/-- **The membership of the interpretation is given by a formula of `L₂`.** -/
theorem bholds_eps2 (e : ℕ → M.Num) (s : ℕ → V) : M.bholds eps2 e s ↔ M.Eps (e 0) (e 1) :=
  M.bholds_epsF (.var 0) (.var 1) e s (M.fr_var (by norm_num)) (M.fr_var (by norm_num))

/-- **The equality of the interpretation is given by a formula of `L₂`.** -/
theorem bholds_eta2 (e : ℕ → M.Num) (s : ℕ → V) : M.bholds eta2 e s ↔ M.Eta (e 0) (e 1) :=
  M.bholds_etaF (.var 0) (.var 1) e s (M.fr_var (by norm_num)) (M.fr_var (by norm_num))

end Model

end NFUCut



/-!
# Phase 3, part 3: from the two-sorted arithmetic language to the language of NFU

`trB` translates a formula of `L₂` into a formula of the language of NFU with the parameters
`1`–`6` for `0`, `ℕ`, the graphs of `+` and `·`, `1`, and the graph of `tw`. The number variable
`i` becomes the name `3 i + 100`, the set variable `X` the name `3 X + 101`; the names
`3 j + 102` are used for the values of subterms.
-/

namespace NFUCut

/-- The name of the number variable `i`. -/
def nv (i : ℕ) : ℕ := 3 * i + 100

/-- The name of the set variable `X`. -/
def sv (X : ℕ) : ℕ := 3 * X + 101

/-- The name of the temporary `j`. -/
def tv (j : ℕ) : ℕ := 3 * j + 102

/-- "The name `out` holds the numeral `n`." -/
def trLit : ℕ → ℕ → ℕ → Fml
  | 0, out, _ => .eq out 1
  | n + 1, out, fr => Fml.ex (tv fr) (.and (trLit n (tv fr) (fr + 1)) (Model.fApp3 3 (tv fr) 5 out))

/-- "The name `out` holds the value of the term." Temporaries from `fr` on are used. -/
def trT : BTm → ℕ → ℕ → Fml
  | .var i, out, _ => .eq out (nv i)
  | .zero, out, _ => .eq out 1
  | .one, out, _ => .eq out 5
  | .lit n, out, fr => trLit n out fr
  | .add s t, out, fr => Fml.ex (tv fr) (Fml.ex (tv (fr + 1)) (.and (trT s (tv fr) (fr + 2))
      (.and (trT t (tv (fr + 1)) (fr + 2)) (Model.fApp3 3 (tv fr) (tv (fr + 1)) out))))
  | .mul s t, out, fr => Fml.ex (tv fr) (Fml.ex (tv (fr + 1)) (.and (trT s (tv fr) (fr + 2))
      (.and (trT t (tv (fr + 1)) (fr + 2)) (Model.fApp3 4 (tv fr) (tv (fr + 1)) out))))

namespace Model

variable {V : Type} [Nonempty V] (M : Model V) [hinf : Fact M.Infinity]

/-- The environment `ρ` holds the parameters and represents the assignments `e`, `s`. -/
structure RepB (ad mu tw : V) (ρ : ℕ → V) (e : ℕ → M.Num) (s : ℕ → V) : Prop where
  h1 : ρ 1 = M.zero
  h2 : ρ 2 = M.nat
  h3 : ρ 3 = ad
  h4 : ρ 4 = mu
  h5 : ρ 5 = (1 : M.Num).1
  h6 : ρ 6 = tw
  hn : ∀ i, ρ (nv i) = (e i).1
  hs : ∀ X, ρ (sv X) = s X

variable {ad mu tw : V} {ρ : ℕ → V} {e : ℕ → M.Num} {s : ℕ → V}

theorem RepB.tmp (h : M.RepB ad mu tw ρ e s) (j : ℕ) (a : V) :
    M.RepB ad mu tw (Function.update ρ (tv j) a) e s where
  h1 := by rw [Function.update_of_ne (by unfold tv; omega)]; exact h.h1
  h2 := by rw [Function.update_of_ne (by unfold tv; omega)]; exact h.h2
  h3 := by rw [Function.update_of_ne (by unfold tv; omega)]; exact h.h3
  h4 := by rw [Function.update_of_ne (by unfold tv; omega)]; exact h.h4
  h5 := by rw [Function.update_of_ne (by unfold tv; omega)]; exact h.h5
  h6 := by rw [Function.update_of_ne (by unfold tv; omega)]; exact h.h6
  hn := fun i => by rw [Function.update_of_ne (by unfold tv nv; omega)]; exact h.hn i
  hs := fun X => by rw [Function.update_of_ne (by unfold tv sv; omega)]; exact h.hs X

theorem RepB.updN (h : M.RepB ad mu tw ρ e s) (x : ℕ) (a : M.Num) :
    M.RepB ad mu tw (Function.update ρ (nv x) a.1) (Function.update e x a) s where
  h1 := by rw [Function.update_of_ne (by unfold nv; omega)]; exact h.h1
  h2 := by rw [Function.update_of_ne (by unfold nv; omega)]; exact h.h2
  h3 := by rw [Function.update_of_ne (by unfold nv; omega)]; exact h.h3
  h4 := by rw [Function.update_of_ne (by unfold nv; omega)]; exact h.h4
  h5 := by rw [Function.update_of_ne (by unfold nv; omega)]; exact h.h5
  h6 := by rw [Function.update_of_ne (by unfold nv; omega)]; exact h.h6
  hn := fun i => by
    by_cases hi : i = x
    · rw [hi, Function.update_self, Function.update_self]
    · rw [Function.update_of_ne (by unfold nv; omega), Function.update_of_ne hi]
      exact h.hn i
  hs := fun X => by rw [Function.update_of_ne (by unfold nv sv; omega)]; exact h.hs X

theorem RepB.updS (h : M.RepB ad mu tw ρ e s) (X : ℕ) (A : V) :
    M.RepB ad mu tw (Function.update ρ (sv X) A) e (Function.update s X A) where
  h1 := by rw [Function.update_of_ne (by unfold sv; omega)]; exact h.h1
  h2 := by rw [Function.update_of_ne (by unfold sv; omega)]; exact h.h2
  h3 := by rw [Function.update_of_ne (by unfold sv; omega)]; exact h.h3
  h4 := by rw [Function.update_of_ne (by unfold sv; omega)]; exact h.h4
  h5 := by rw [Function.update_of_ne (by unfold sv; omega)]; exact h.h5
  h6 := by rw [Function.update_of_ne (by unfold sv; omega)]; exact h.h6
  hn := fun i => by rw [Function.update_of_ne (by unfold nv sv; omega)]; exact h.hn i
  hs := fun Y => by
    by_cases hY : Y = X
    · rw [hY, Function.update_self, Function.update_self]
    · rw [Function.update_of_ne (by unfold sv; omega), Function.update_of_ne hY]
      exact h.hs Y

theorem tv_gt (j : ℕ) : 99 < tv j := by unfold tv; omega

theorem tv_inj {i j : ℕ} (h : tv i = tv j) : i = j := by unfold tv at h; omega

theorem sat_trLit (had : M.IsGraphOf₂ ad M.addN) :
    ∀ (n out fr : ℕ) (ρ : ℕ → V), M.RepB ad mu tw ρ e s → 99 < out → (∀ j, fr ≤ j → out ≠ tv j) →
      (Sat M.mem M.isSet (trLit n out fr) ρ ↔ ρ out = ((n : ℕ) : M.Num).1) := by
  intro n
  induction n with
  | zero =>
    intro out fr ρ h _ _
    simp only [trLit, Sat, h.h1, Nat.cast_zero]
    rfl
  | succ n ih =>
    intro out fr ρ h hout hfr
    have hne : out ≠ tv fr := hfr fr (le_refl _)
    simp only [trLit, M.sat_ex, Sat]
    constructor
    · rintro ⟨a, h1, h2⟩
      rw [ih (tv fr) (fr + 1) _ (RepB.tmp M h fr a) (tv_gt fr)
        (fun j hj e' => by have := tv_inj e'; omega), Function.update_self] at h1
      rw [M.sat_fApp3 (G := 3) (a := tv fr) (b := 5) (c := out) _ (by decide) (Or.inr (tv_gt fr)) (Or.inl (by decide)) (Or.inr hout),
        Function.update_self, Function.update_of_ne hne, Function.update_of_ne (by unfold tv; omega),
        Function.update_of_ne (by unfold tv; omega), h.h3, h.h5, h1] at h2
      rw [M.graph₂_val had h2, Nat.cast_succ]
      rfl
    · intro hval
      refine ⟨((n : ℕ) : M.Num).1, ?_, ?_⟩
      · rw [ih (tv fr) (fr + 1) _ (RepB.tmp M h fr _) (tv_gt fr)
          (fun j hj e' => by have := tv_inj e'; omega), Function.update_self]
      · rw [M.sat_fApp3 (G := 3) (a := tv fr) (b := 5) (c := out) _ (by decide) (Or.inr (tv_gt fr)) (Or.inl (by decide)) (Or.inr hout),
          Function.update_self, Function.update_of_ne hne,
          Function.update_of_ne (by unfold tv; omega),
          Function.update_of_ne (by unfold tv; omega), h.h3, h.h5, hval, Nat.cast_succ]
        exact M.graph₂_app had _ _

theorem sat_trT (had : M.IsGraphOf₂ ad M.addN) (hmu : M.IsGraphOf₂ mu M.mulN) :
    ∀ (t : BTm) (out fr : ℕ) (ρ : ℕ → V), M.RepB ad mu tw ρ e s → 99 < out →
      (∀ j, fr ≤ j → out ≠ tv j) →
      (Sat M.mem M.isSet (trT t out fr) ρ ↔ ρ out = (M.evalT t e).1) := by
  intro t
  induction t with
  | var i =>
    intro out fr ρ h _ _
    simp only [trT, Sat, h.hn i, evalT]
  | zero =>
    intro out fr ρ h _ _
    simp only [trT, Sat, h.h1, evalT]
    rfl
  | one =>
    intro out fr ρ h _ _
    simp only [trT, Sat, h.h5, evalT]
  | lit n =>
    intro out fr ρ h hout hfr
    simp only [trT, evalT]
    exact M.sat_trLit had n out fr ρ h hout hfr
  | add t1 t2 ih1 ih2 =>
    intro out fr ρ h hout hfr
    have hne0 : out ≠ tv fr := hfr fr (le_refl _)
    have hne1 : out ≠ tv (fr + 1) := hfr (fr + 1) (Nat.le_succ _)
    have hne01 : tv fr ≠ tv (fr + 1) := fun e' => by have := tv_inj e'; omega
    have key : ∀ a b : V, (Sat M.mem M.isSet (.and (trT t1 (tv fr) (fr + 2))
        (.and (trT t2 (tv (fr + 1)) (fr + 2)) (fApp3 3 (tv fr) (tv (fr + 1)) out)))
        (Function.update (Function.update ρ (tv fr) a) (tv (fr + 1)) b) ↔
        a = (M.evalT t1 e).1 ∧ b = (M.evalT t2 e).1 ∧ M.mem (M.trip a b (ρ out)) ad) := by
      intro a b
      simp only [Sat]
      rw [ih1 (tv fr) (fr + 2) _ (RepB.tmp M (RepB.tmp M h fr a) (fr + 1) b) (tv_gt fr)
          (fun j hj e' => by have := tv_inj e'; omega),
        ih2 (tv (fr + 1)) (fr + 2) _ (RepB.tmp M (RepB.tmp M h fr a) (fr + 1) b) (tv_gt _)
          (fun j hj e' => by have := tv_inj e'; omega),
        M.sat_fApp3 (G := 3) (a := tv fr) (b := tv (fr + 1)) (c := out) _ (by decide)
          (Or.inr (tv_gt fr)) (Or.inr (tv_gt _)) (Or.inr hout),
        Function.update_self, Function.update_of_ne hne01, Function.update_self,
        Function.update_of_ne hne1, Function.update_of_ne hne0,
        Function.update_of_ne (by unfold tv; omega), Function.update_of_ne (by unfold tv; omega),
        h.h3]
    simp only [trT, M.sat_ex, evalT]
    constructor
    · rintro ⟨a, b, hab⟩
      obtain ⟨rfl, rfl, hm⟩ := (key a b).mp hab
      exact M.graph₂_val had hm
    · intro hval
      refine ⟨(M.evalT t1 e).1, (M.evalT t2 e).1, (key _ _).mpr ⟨rfl, rfl, ?_⟩⟩
      rw [hval]
      exact M.graph₂_app had _ _
  | mul t1 t2 ih1 ih2 =>
    intro out fr ρ h hout hfr
    have hne0 : out ≠ tv fr := hfr fr (le_refl _)
    have hne1 : out ≠ tv (fr + 1) := hfr (fr + 1) (Nat.le_succ _)
    have hne01 : tv fr ≠ tv (fr + 1) := fun e' => by have := tv_inj e'; omega
    have key : ∀ a b : V, (Sat M.mem M.isSet (.and (trT t1 (tv fr) (fr + 2))
        (.and (trT t2 (tv (fr + 1)) (fr + 2)) (fApp3 4 (tv fr) (tv (fr + 1)) out)))
        (Function.update (Function.update ρ (tv fr) a) (tv (fr + 1)) b) ↔
        a = (M.evalT t1 e).1 ∧ b = (M.evalT t2 e).1 ∧ M.mem (M.trip a b (ρ out)) mu) := by
      intro a b
      simp only [Sat]
      rw [ih1 (tv fr) (fr + 2) _ (RepB.tmp M (RepB.tmp M h fr a) (fr + 1) b) (tv_gt fr)
          (fun j hj e' => by have := tv_inj e'; omega),
        ih2 (tv (fr + 1)) (fr + 2) _ (RepB.tmp M (RepB.tmp M h fr a) (fr + 1) b) (tv_gt _)
          (fun j hj e' => by have := tv_inj e'; omega),
        M.sat_fApp3 (G := 4) (a := tv fr) (b := tv (fr + 1)) (c := out) _ (by decide)
          (Or.inr (tv_gt fr)) (Or.inr (tv_gt _)) (Or.inr hout),
        Function.update_self, Function.update_of_ne hne01, Function.update_self,
        Function.update_of_ne hne1, Function.update_of_ne hne0,
        Function.update_of_ne (by unfold tv; omega), Function.update_of_ne (by unfold tv; omega),
        h.h4]
    simp only [trT, M.sat_ex, evalT]
    constructor
    · rintro ⟨a, b, hab⟩
      obtain ⟨rfl, rfl, hm⟩ := (key a b).mp hab
      exact M.graph₂_val hmu hm
    · intro hval
      refine ⟨(M.evalT t1 e).1, (M.evalT t2 e).1, (key _ _).mpr ⟨rfl, rfl, ?_⟩⟩
      rw [hval]
      exact M.graph₂_app hmu _ _

end Model

end NFUCut



/-!
# Phase 3, part 4: the cut `𝖪ₜ` as a formula, and the translation of `L₂`
-/

namespace NFUCut

/-- "The name `y` holds a number of the cut `𝖲`": a natural number with a strongly cantorian
member. Bound names `10`–`17`. -/
def fInSn (y : ℕ) : Fml :=
  .and (.mem y 2) (Fml.ex 10 (.and (.mem 10 y) (Fml.ex 11 (.all 12 (Fml.iff (.mem 12 11)
    (Fml.ex 13 (.and (.mem 13 10) (Fml.ex 14 (.and (Model.fSing 14 13 15)
      (Model.fOp 12 13 14 16 17))))))))))

/-- "`tw` of the number held by `a` is in `𝖲`." Bound name `18`. -/
def fC (a : ℕ) : Fml := Fml.ex 18 (.and (Model.fApp 6 a 18) (fInSn 18))

/-- The first shortening. Bound names `19`, `20`. -/
def fK1 (m : ℕ) : Fml :=
  .all 19 (Fml.imp (.and (.mem 19 2) (fC 19)) (Fml.ex 20 (.and (Model.fApp3 3 19 m 20) (fC 20))))

/-- "The name `n` holds a number of the cut `𝖪ₜ`." Bound names `21`, `22`. -/
def fKt (n : ℕ) : Fml :=
  .all 21 (Fml.imp (.and (.mem 21 2) (fK1 21)) (Fml.ex 22 (.and (Model.fApp3 4 21 n 22) (fK1 22))))

namespace Model

variable {V : Type} [Nonempty V] (M : Model V) [hinf : Fact M.Infinity]

theorem sat_fInSn {y : ℕ} (hy : 17 < y) (ρ : ℕ → V) (h2 : ρ 2 = M.nat) :
    Sat M.mem M.isSet (fInSn y) ρ ↔ M.InS (ρ y) := by
  have e0 : (2 : ℕ) ≠ 10 := by decide
  have e1 : y ≠ 10 := by omega
  have e2 : y ≠ 11 := by omega
  have e3 : y ≠ 12 := by omega
  have e4 : y ≠ 13 := by omega
  have e5 : y ≠ 14 := by omega
  unfold fInSn InS SC IsGraph
  simp only [Sat, M.sat_ex, M.sat_iff,
    M.sat_fSing (u := 14) (a := 13) (c := 15) (by decide) (by decide),
    M.sat_fOp (p := 12) (a := 13) (b := 14) (u := 16) (c := 17) (by decide) (by decide)
      (by decide) (by decide) (by decide) (by decide),
    Function.update_self, Function.update_of_ne e1, Function.update_of_ne e2,
    Function.update_of_ne e3, Function.update_of_ne e4, Function.update_of_ne e5,
    Function.update_of_ne (show (10 : ℕ) ≠ 11 by decide),
    Function.update_of_ne (show (10 : ℕ) ≠ 12 by decide),
    Function.update_of_ne (show (10 : ℕ) ≠ 13 by decide),
    Function.update_of_ne (show (10 : ℕ) ≠ 14 by decide),
    Function.update_of_ne (show (11 : ℕ) ≠ 12 by decide),
    Function.update_of_ne (show (11 : ℕ) ≠ 13 by decide),
    Function.update_of_ne (show (11 : ℕ) ≠ 14 by decide),
    Function.update_of_ne (show (12 : ℕ) ≠ 13 by decide),
    Function.update_of_ne (show (12 : ℕ) ≠ 14 by decide),
    Function.update_of_ne (show (13 : ℕ) ≠ 14 by decide), h2]
  refine and_congr Iff.rfl (exists_congr fun x => and_congr Iff.rfl (exists_congr fun f =>
    forall_congr' fun p => iff_congr Iff.rfl (exists_congr fun a => and_congr Iff.rfl ?_)))
  constructor
  · rintro ⟨sa, rfl, h⟩
    exact h
  · intro h
    exact ⟨_, rfl, h⟩

theorem sat_fC {tw : V} (htw : M.IsGraphOf tw M.tw) {a : ℕ} (ha : a = 19 ∨ a = 20) (ρ : ℕ → V)
    (h2 : ρ 2 = M.nat) (h6 : ρ 6 = tw) (x : M.Num) (hx : ρ a = x.1) :
    Sat M.mem M.isSet (fC a) ρ ↔ M.InS (M.tw x).1 := by
  have ea : a ≠ 18 := by omega
  unfold fC
  simp only [M.sat_ex, Sat]
  constructor
  · rintro ⟨u, h1, h3⟩
    rw [M.sat_fApp' _ (Or.inl (by decide)) (Or.inl (by omega)) (Or.inl (by decide)),
      Function.update_self, Function.update_of_ne ea, Function.update_of_ne (by decide), h6,
      hx] at h1
    rw [M.sat_fInSn (by decide) _ (by rw [Function.update_of_ne (by decide)]; exact h2),
      Function.update_self, M.graph_val htw h1] at h3
    exact h3
  · intro h
    refine ⟨(M.tw x).1, ?_, ?_⟩
    · rw [M.sat_fApp' _ (Or.inl (by decide)) (Or.inl (by omega)) (Or.inl (by decide)),
        Function.update_self, Function.update_of_ne ea, Function.update_of_ne (by decide), h6, hx]
      exact M.graph_app htw x
    · rw [M.sat_fInSn (by decide) _ (by rw [Function.update_of_ne (by decide)]; exact h2),
        Function.update_self]
      exact h

end Model

end NFUCut



/-!
# Phase 3, part 5: the translation of `L₂` into the language of NFU, with parameters
-/

namespace NFUCut

/-- The translation of a formula of `L₂`. Parameters: the names `1`–`6` for `0`, `ℕ`, the graph
of `+`, the graph of `·`, `1`, and the graph of `tw`. -/
def trB : BFml → Fml
  | .eq s t => Fml.ex (tv 0) (Fml.ex (tv 1) (.and (trT s (tv 0) 2) (.and (trT t (tv 1) 2)
      (.eq (tv 0) (tv 1)))))
  | .le s t => Fml.ex (tv 0) (Fml.ex (tv 1) (.and (trT s (tv 0) 2) (.and (trT t (tv 1) 2)
      (Fml.ex 23 (.and (.mem 23 2) (Model.fApp3 3 (tv 0) 23 (tv 1)))))))
  | .mem t X => Fml.ex (tv 0) (.and (trT t (tv 0) 1) (.mem (tv 0) (sv X)))
  | .inKt t => Fml.ex (tv 0) (.and (trT t (tv 0) 1) (fKt (tv 0)))
  | .neg φ => .neg (trB φ)
  | .and φ ψ => .and (trB φ) (trB ψ)
  | .all x φ => .all (nv x) (Fml.imp (.mem (nv x) 2) (trB φ))
  | .allS X φ => .all (sv X) (trB φ)

namespace Model

variable {V : Type} [Nonempty V] (M : Model V) [hinf : Fact M.Infinity]

theorem sat_fK1 {ad tw : V} (had : M.IsGraphOf₂ ad M.addN) (htw : M.IsGraphOf tw M.tw) {m : ℕ}
    (hm : m = 21 ∨ m = 22) (ρ : ℕ → V) (h2 : ρ 2 = M.nat) (h3 : ρ 3 = ad) (h6 : ρ 6 = tw)
    (x : M.Num) (hx : ρ m = x.1) :
    Sat M.mem M.isSet (fK1 m) ρ ↔ Shortening.K₁ (fun n : M.Num => M.InS n.1) M.tw x := by
  have em19 : m ≠ 19 := by omega
  have em20 : m ≠ 20 := by omega
  have key : ∀ a : M.Num, (Sat M.mem M.isSet (Fml.imp (.and (.mem 19 2) (fC 19))
      (Fml.ex 20 (.and (fApp3 3 19 m 20) (fC 20)))) (Function.update ρ 19 a.1) ↔
      (M.InS (M.tw a).1 → M.InS (M.tw (a + x)).1)) := by
    intro a
    have r2 : Function.update ρ 19 a.1 2 = M.nat := by
      rw [Function.update_of_ne (by decide)]
      exact h2
    have r6 : Function.update ρ 19 a.1 6 = tw := by
      rw [Function.update_of_ne (by decide)]
      exact h6
    have r2' : ∀ c : V, Function.update (Function.update ρ 19 a.1) 20 c 2 = M.nat := fun c => by
      rw [Function.update_of_ne (by decide)]
      exact r2
    have r6' : ∀ c : V, Function.update (Function.update ρ 19 a.1) 20 c 6 = tw := fun c => by
      rw [Function.update_of_ne (by decide)]
      exact r6
    have happ : ∀ c : V, (Sat M.mem M.isSet (fApp3 3 19 m 20)
        (Function.update (Function.update ρ 19 a.1) 20 c) ↔ M.mem (M.trip a.1 x.1 c) ad) := by
      intro c
      rw [M.sat_fApp3 (G := 3) (a := 19) (b := m) (c := 20) _ (by decide) (Or.inl (by decide))
        (Or.inl (by omega)) (Or.inl (by decide)), Function.update_self,
        Function.update_of_ne (by decide : (19 : ℕ) ≠ 20), Function.update_self,
        Function.update_of_ne em20, Function.update_of_ne em19, hx,
        Function.update_of_ne (by decide : (3 : ℕ) ≠ 20),
        Function.update_of_ne (by decide : (3 : ℕ) ≠ 19), h3]
    rw [M.sat_imp]
    simp only [Sat, M.sat_ex]
    rw [M.sat_fC htw (Or.inl rfl) _ r2 r6 a (Function.update_self _ _ _), Function.update_self, r2]
    constructor
    · intro h ha
      obtain ⟨c, hc1, hc2⟩ := h ⟨a.2, ha⟩
      have ec := M.graph₂_val had ((happ c).mp hc1)
      rw [M.sat_fC htw (Or.inr rfl) _ (r2' c) (r6' c) (a + x) (by
        rw [Function.update_self]
        exact ec)] at hc2
      exact hc2
    · rintro h ⟨-, ha⟩
      refine ⟨(a + x).1, (happ _).mpr (M.graph₂_app had a x), ?_⟩
      rw [M.sat_fC htw (Or.inr rfl) _ (r2' _) (r6' _) (a + x) (Function.update_self _ _ _)]
      exact h ha
  unfold fK1 Shortening.K₁ Shortening.C₂
  simp only [Sat]
  constructor
  · intro h a
    exact (key a).mp (h a.1)
  · intro h a
    by_cases ha : M.mem a M.nat
    · exact (key ⟨a, ha⟩).mpr (h ⟨a, ha⟩)
    · rw [M.sat_imp]
      rintro ⟨h1, -⟩
      simp only [Sat] at h1
      rw [Function.update_self, Function.update_of_ne (by decide), h2] at h1
      exact absurd h1 ha

theorem sat_fKt {ad mu tw : V} (had : M.IsGraphOf₂ ad M.addN) (hmu : M.IsGraphOf₂ mu M.mulN)
    (htw : M.IsGraphOf tw M.tw) {n : ℕ} (hn : 99 < n) (ρ : ℕ → V) (h2 : ρ 2 = M.nat)
    (h3 : ρ 3 = ad) (h4 : ρ 4 = mu) (h6 : ρ 6 = tw) (x : M.Num) (hx : ρ n = x.1) :
    Sat M.mem M.isSet (fKt n) ρ ↔ M.InKt x := by
  have en21 : n ≠ 21 := by omega
  have en22 : n ≠ 22 := by omega
  have key : ∀ a : M.Num, (Sat M.mem M.isSet (Fml.imp (.and (.mem 21 2) (fK1 21))
      (Fml.ex 22 (.and (fApp3 4 21 n 22) (fK1 22)))) (Function.update ρ 21 a.1) ↔
      (Shortening.K₁ (fun n : M.Num => M.InS n.1) M.tw a →
        Shortening.K₁ (fun n : M.Num => M.InS n.1) M.tw (a * x))) := by
    intro a
    have r2 : Function.update ρ 21 a.1 2 = M.nat := by
      rw [Function.update_of_ne (by decide)]
      exact h2
    have r3 : Function.update ρ 21 a.1 3 = ad := by
      rw [Function.update_of_ne (by decide)]
      exact h3
    have r6 : Function.update ρ 21 a.1 6 = tw := by
      rw [Function.update_of_ne (by decide)]
      exact h6
    have r2' : ∀ c : V, Function.update (Function.update ρ 21 a.1) 22 c 2 = M.nat := fun c => by
      rw [Function.update_of_ne (by decide)]
      exact r2
    have r3' : ∀ c : V, Function.update (Function.update ρ 21 a.1) 22 c 3 = ad := fun c => by
      rw [Function.update_of_ne (by decide)]
      exact r3
    have r6' : ∀ c : V, Function.update (Function.update ρ 21 a.1) 22 c 6 = tw := fun c => by
      rw [Function.update_of_ne (by decide)]
      exact r6
    have happ : ∀ c : V, (Sat M.mem M.isSet (fApp3 4 21 n 22)
        (Function.update (Function.update ρ 21 a.1) 22 c) ↔ M.mem (M.trip a.1 x.1 c) mu) := by
      intro c
      rw [M.sat_fApp3 (G := 4) (a := 21) (b := n) (c := 22) _ (by decide) (Or.inl (by decide))
        (Or.inr hn) (Or.inl (by decide)), Function.update_self,
        Function.update_of_ne (by decide : (21 : ℕ) ≠ 22), Function.update_self,
        Function.update_of_ne en22, Function.update_of_ne en21, hx,
        Function.update_of_ne (by decide : (4 : ℕ) ≠ 22),
        Function.update_of_ne (by decide : (4 : ℕ) ≠ 21), h4]
    rw [M.sat_imp]
    simp only [Sat, M.sat_ex]
    rw [M.sat_fK1 had htw (Or.inl rfl) _ r2 r3 r6 a (Function.update_self _ _ _),
      Function.update_self, r2]
    constructor
    · intro h ha
      obtain ⟨c, hc1, hc2⟩ := h ⟨a.2, ha⟩
      have ec := M.graph₂_val hmu ((happ c).mp hc1)
      rw [M.sat_fK1 had htw (Or.inr rfl) _ (r2' c) (r3' c) (r6' c) (a * x) (by
        rw [Function.update_self]
        exact ec)] at hc2
      exact hc2
    · rintro h ⟨-, ha⟩
      refine ⟨(a * x).1, (happ _).mpr (M.graph₂_app hmu a x), ?_⟩
      rw [M.sat_fK1 had htw (Or.inr rfl) _ (r2' _) (r3' _) (r6' _) (a * x)
        (Function.update_self _ _ _)]
      exact h ha
  unfold fKt InKt Shortening.K
  simp only [Sat]
  constructor
  · intro h a
    exact (key a).mp (h a.1)
  · intro h a
    by_cases ha : M.mem a M.nat
    · exact (key ⟨a, ha⟩).mpr (h ⟨a, ha⟩)
    · rw [M.sat_imp]
      rintro ⟨h1, -⟩
      simp only [Sat] at h1
      rw [Function.update_self, Function.update_of_ne (by decide), h2] at h1
      exact absurd h1 ha

/-- **The translation is correct.** -/
theorem sat_trB {ad mu tw : V} (had : M.IsGraphOf₂ ad M.addN) (hmu : M.IsGraphOf₂ mu M.mulN)
    (htw : M.IsGraphOf tw M.tw) :
    ∀ (φ : BFml) (ρ : ℕ → V) (e : ℕ → M.Num) (s : ℕ → V), M.RepB ad mu tw ρ e s →
      (Sat M.mem M.isSet (trB φ) ρ ↔ M.bholds φ e s) := by
  have h01 : tv 0 ≠ tv 1 := by unfold tv; omega
  have two : ∀ (t1 t2 : BTm) (ρ : ℕ → V) (e : ℕ → M.Num) (s : ℕ → V) (a b : V),
      M.RepB ad mu tw ρ e s →
      (Sat M.mem M.isSet (trT t1 (tv 0) 2) (Function.update (Function.update ρ (tv 0) a) (tv 1) b) ∧
        Sat M.mem M.isSet (trT t2 (tv 1) 2) (Function.update (Function.update ρ (tv 0) a) (tv 1) b) ↔
        a = (M.evalT t1 e).1 ∧ b = (M.evalT t2 e).1) := by
    intro t1 t2 ρ e s a b h
    rw [M.sat_trT had hmu t1 (tv 0) 2 _ (RepB.tmp M (RepB.tmp M h 0 a) 1 b) (tv_gt 0)
        (fun j hj e' => by have := tv_inj e'; omega),
      M.sat_trT had hmu t2 (tv 1) 2 _ (RepB.tmp M (RepB.tmp M h 0 a) 1 b) (tv_gt 1)
        (fun j hj e' => by have := tv_inj e'; omega),
      Function.update_self, Function.update_of_ne h01, Function.update_self]
  have one : ∀ (t : BTm) (ρ : ℕ → V) (e : ℕ → M.Num) (s : ℕ → V) (a : V),
      M.RepB ad mu tw ρ e s →
      (Sat M.mem M.isSet (trT t (tv 0) 1) (Function.update ρ (tv 0) a) ↔ a = (M.evalT t e).1) := by
    intro t ρ e s a h
    rw [M.sat_trT had hmu t (tv 0) 1 _ (RepB.tmp M h 0 a) (tv_gt 0)
      (fun j hj e' => by have := tv_inj e'; omega), Function.update_self]
  intro φ
  induction φ with
  | eq t1 t2 =>
    intro ρ e s h
    simp only [trB, M.sat_ex, bholds]
    constructor
    · rintro ⟨a, b, hab⟩
      have hab' := hab
      simp only [Sat] at hab'
      obtain ⟨h1, h2, h3⟩ := hab'
      obtain ⟨rfl, rfl⟩ := (two t1 t2 ρ e s a b h).mp ⟨h1, h2⟩
      rw [Function.update_self, Function.update_of_ne h01, Function.update_self] at h3
      exact Subtype.ext h3
    · intro heq
      refine ⟨(M.evalT t1 e).1, (M.evalT t2 e).1, ?_⟩
      simp only [Sat]
      obtain ⟨h1, h2⟩ := (two t1 t2 ρ e s _ _ h).mpr ⟨rfl, rfl⟩
      refine ⟨h1, h2, ?_⟩
      rw [Function.update_self, Function.update_of_ne h01, Function.update_self, heq]
  | le t1 t2 =>
    intro ρ e s h
    have happ : ∀ a b c : V, (Sat M.mem M.isSet (fApp3 3 (tv 0) 23 (tv 1))
        (Function.update (Function.update (Function.update ρ (tv 0) a) (tv 1) b) 23 c) ↔
        M.mem (M.trip a c b) ad) := by
      intro a b c
      rw [M.sat_fApp3 (G := 3) (a := tv 0) (b := 23) (c := tv 1) _ (by decide)
        (Or.inr (tv_gt 0)) (Or.inl (by decide)) (Or.inr (tv_gt 1)),
        Function.update_self, Function.update_of_ne (by unfold tv; omega),
        Function.update_of_ne h01, Function.update_self,
        Function.update_of_ne (by unfold tv; omega), Function.update_self,
        Function.update_of_ne (by decide : (3 : ℕ) ≠ 23),
        Function.update_of_ne (by unfold tv; omega), Function.update_of_ne (by unfold tv; omega),
        h.h3]
    have hnat : ∀ a b c : V, Function.update (Function.update (Function.update ρ (tv 0) a)
        (tv 1) b) 23 c 2 = M.nat := by
      intro a b c
      rw [Function.update_of_ne (by decide), Function.update_of_ne (by unfold tv; omega),
        Function.update_of_ne (by unfold tv; omega)]
      exact h.h2
    simp only [trB, M.sat_ex, bholds]
    constructor
    · rintro ⟨a, b, hab⟩
      have hab' := hab
      simp only [Sat, M.sat_ex] at hab'
      obtain ⟨h1, h2, c, hc1, hc2⟩ := hab'
      obtain ⟨rfl, rfl⟩ := (two t1 t2 ρ e s a b h).mp ⟨h1, h2⟩
      rw [Function.update_self, hnat] at hc1
      have ec := M.graph₂_val had (n := ⟨c, hc1⟩) ((happ _ _ c).mp hc2)
      exact M.le_def.mpr ⟨⟨c, hc1⟩, Subtype.ext ec.symm⟩
    · intro hle
      obtain ⟨c, hc⟩ := M.le_def.mp hle
      refine ⟨(M.evalT t1 e).1, (M.evalT t2 e).1, ?_⟩
      simp only [Sat, M.sat_ex]
      obtain ⟨h1, h2⟩ := (two t1 t2 ρ e s _ _ h).mpr ⟨rfl, rfl⟩
      refine ⟨h1, h2, c.1, ?_, (happ _ _ _).mpr ?_⟩
      · rw [Function.update_self, hnat]
        exact c.2
      · rw [← hc]
        exact M.graph₂_app had _ _
  | mem t X =>
    intro ρ e s h
    simp only [trB, M.sat_ex, bholds]
    constructor
    · rintro ⟨a, ha⟩
      have ha' := ha
      simp only [Sat] at ha'
      obtain ⟨h1, h2⟩ := ha'
      have ea := (one t ρ e s a h).mp h1
      rw [Function.update_self, Function.update_of_ne (by unfold tv sv; omega), h.hs X, ea] at h2
      exact h2
    · intro hm
      refine ⟨(M.evalT t e).1, ?_⟩
      simp only [Sat]
      refine ⟨(one t ρ e s _ h).mpr rfl, ?_⟩
      rw [Function.update_self, Function.update_of_ne (by unfold tv sv; omega), h.hs X]
      exact hm
  | inKt t =>
    intro ρ e s h
    have hkt : ∀ a : V, a = (M.evalT t e).1 → (Sat M.mem M.isSet (fKt (tv 0))
        (Function.update ρ (tv 0) a) ↔ M.InKt (M.evalT t e)) := by
      intro a ea
      have h' := RepB.tmp M h 0 a
      exact M.sat_fKt had hmu htw (tv_gt 0) _ h'.h2 h'.h3 h'.h4 h'.h6 _
        (by rw [Function.update_self]; exact ea)
    simp only [trB, M.sat_ex, bholds]
    constructor
    · rintro ⟨a, ha⟩
      have ha' := ha
      simp only [Sat] at ha'
      obtain ⟨h1, h2⟩ := ha'
      exact (hkt a ((one t ρ e s a h).mp h1)).mp h2
    · intro hk
      refine ⟨(M.evalT t e).1, ?_⟩
      simp only [Sat]
      exact ⟨(one t ρ e s _ h).mpr rfl, (hkt _ rfl).mpr hk⟩
  | neg φ ih =>
    intro ρ e s h
    simp only [trB, Sat, bholds, ih ρ e s h]
  | and φ ψ ih1 ih2 =>
    intro ρ e s h
    simp only [trB, Sat, bholds, ih1 ρ e s h, ih2 ρ e s h]
  | all x φ ih =>
    intro ρ e s h
    have hx2 : (2 : ℕ) ≠ nv x := by unfold nv; omega
    simp only [trB, Sat, M.sat_imp, bholds, Function.update_self, Function.update_of_ne hx2, h.h2]
    constructor
    · intro hall a
      exact (ih _ _ _ (RepB.updN M h x a)).mp (hall a.1 a.2)
    · intro hall a ha
      exact (ih _ _ _ (RepB.updN M h x ⟨a, ha⟩)).mpr (hall ⟨a, ha⟩)
  | allS X φ ih =>
    intro ρ e s h
    simp only [trB, Sat, bholds]
    exact forall_congr' fun A => ih _ _ _ (RepB.updS M h X A)

end Model

end NFUCut



/-!
# Phase 3, part 6: the parameters are definable

The graph of a function on the numbers that is given by a recursion is characterised, among
the sets of triples (or pairs), by: its members have numbers as components, it is total and
functional, and it satisfies the equations of the recursion.
-/

namespace NFUCut

namespace Model

variable {V : Type} [Nonempty V] (M : Model V) [hinf : Fact M.Infinity]

/-- A set of triples of numbers that is total and functional is the graph of an operation. -/
theorem exists_op_of_graph {G : V}
    (hnum : ∀ a b c, M.mem (M.trip a b c) G → M.mem a M.nat ∧ M.mem b M.nat ∧ M.mem c M.nat)
    (htot : ∀ a b, M.mem a M.nat → M.mem b M.nat → ∃ c, M.mem (M.trip a b c) G)
    (hfun : ∀ a b c c', M.mem (M.trip a b c) G → M.mem (M.trip a b c') G → c = c') :
    ∃ F : M.Num → M.Num → M.Num, M.IsGraphOf₂ G F := by
  choose f hf using fun (a b : M.Num) => htot a.1 b.1 a.2 b.2
  refine ⟨fun a b => ⟨f a b, (hnum _ _ _ (hf a b)).2.2⟩, fun a b c => ⟨fun h => ?_, ?_⟩⟩
  · obtain ⟨ha, hb, -⟩ := hnum _ _ _ h
    exact ⟨⟨a, ha⟩, ⟨b, hb⟩, rfl, rfl, hfun _ _ _ _ (hf ⟨a, ha⟩ ⟨b, hb⟩) h⟩
  · rintro ⟨m, n, rfl, rfl, rfl⟩
    exact hf m n

/-- A set of pairs of numbers that is total and functional is the graph of a function. -/
theorem exists_fn_of_graph {G : V}
    (hnum : ∀ a c, M.mem (M.op a c) G → M.mem a M.nat ∧ M.mem c M.nat)
    (htot : ∀ a, M.mem a M.nat → ∃ c, M.mem (M.op a c) G)
    (hfun : ∀ a c c', M.mem (M.op a c) G → M.mem (M.op a c') G → c = c') :
    ∃ F : M.Num → M.Num, M.IsGraphOf G F := by
  choose f hf using fun (a : M.Num) => htot a.1 a.2
  refine ⟨fun a => ⟨f a, (hnum _ _ (hf a)).2⟩, fun a c => ⟨fun h => ?_, ?_⟩⟩
  · obtain ⟨ha, -⟩ := hnum _ _ h
    exact ⟨⟨a, ha⟩, rfl, hfun _ _ _ (hf ⟨a, ha⟩) h⟩
  · rintro ⟨m, rfl, rfl⟩
    exact hf m

/-- Uniqueness of a recursion on the second argument. -/
theorem op_unique {F H : M.Num → M.Num → M.Num} (hF : M.NatOp F) (hH : M.NatOp H)
    (h0 : ∀ a, F a 0 = H a 0) (hs : ∀ a b, F a b = H a b → F a (b + 1) = H a (b + 1)) :
    F = H := by
  funext a b
  refine M.num_ind (P := fun b => F a b = H a b)
    (M.isPred_eq (M.natFn_op₂ hF (M.natFn_const a) M.natFn_id)
      (M.natFn_op₂ hH (M.natFn_const a) M.natFn_id)) (h0 a) ?_ b
  intro k ih
  rw [M.nsucc_eq_add_one]
  exact hs a k ih

/-- Uniqueness of a recursion. -/
theorem fn_unique {F H : M.Num → M.Num} (hF : M.NatFn F) (hH : M.NatFn H)
    (h0 : F 0 = H 0) (hs : ∀ b, F b = H b → F (b + 1) = H (b + 1)) : F = H := by
  funext b
  refine M.num_ind (P := fun b => F b = H b) (M.isPred_eq hF hH) h0 ?_ b
  intro k ih
  rw [M.nsucc_eq_add_one]
  exact hs k ih

theorem graph₂_congr {G : V} {F H : M.Num → M.Num → M.Num} (h : M.IsGraphOf₂ G F) (e : F = H) :
    M.IsGraphOf₂ G H := e ▸ h

/-- The specification of the graph of addition. -/
def AddSpec (A : V) : Prop :=
  (∀ a b c, M.mem (M.trip a b c) A → M.mem a M.nat ∧ M.mem b M.nat ∧ M.mem c M.nat) ∧
  (∀ a b, M.mem a M.nat → M.mem b M.nat → ∃ c, M.mem (M.trip a b c) A) ∧
  (∀ a b c c', M.mem (M.trip a b c) A → M.mem (M.trip a b c') A → c = c') ∧
  (∀ a, M.mem a M.nat → M.mem (M.trip a M.zero a) A) ∧
  (∀ a b c, M.mem (M.trip a b c) A → M.mem (M.trip a (M.succ b) (M.succ c)) A)

theorem addSpec_iff {A : V} : M.AddSpec A ↔ M.IsGraphOf₂ A M.addN := by
  constructor
  · rintro ⟨hnum, htot, hfun, h0, hs⟩
    obtain ⟨F, hF⟩ := M.exists_op_of_graph hnum htot hfun
    refine M.graph₂_congr hF (M.op_unique ⟨A, hF⟩ M.addN_natOp (fun a => ?_) (fun a b ih => ?_))
    · rw [show M.addN a 0 = a from M.addN_zero a]
      exact Subtype.ext (M.graph₂_val hF (n := 0) (h0 a.1 a.2)).symm
    · have h1 := hs _ _ _ (M.graph₂_app hF a b)
      have h2 : M.mem (M.trip a.1 (b + 1 : M.Num).1 (F a b + 1 : M.Num).1) A := by
        rw [← M.nsucc_eq_add_one, ← M.nsucc_eq_add_one]
        exact h1
      rw [Subtype.ext (M.graph₂_val hF h2).symm, ih, ← M.nsucc_eq_add_one, ← M.nsucc_eq_add_one]
      exact (M.addN_succ a b).symm
  · intro hA
    refine ⟨fun a b c h => ?_, fun a b ha hb => ⟨_, M.graph₂_app hA ⟨a, ha⟩ ⟨b, hb⟩⟩,
      fun a b c c' h h' => ?_, fun a ha => ?_, fun a b c h => ?_⟩
    · obtain ⟨m, n, rfl, rfl, rfl⟩ := (hA _ _ _).mp h
      exact ⟨m.2, n.2, (M.addN m n).2⟩
    · obtain ⟨m, n, rfl, rfl, rfl⟩ := (hA _ _ _).mp h
      exact (M.graph₂_val hA h').symm
    · have h := M.graph₂_app hA ⟨a, ha⟩ 0
      rw [show M.addN ⟨a, ha⟩ 0 = ⟨a, ha⟩ from M.addN_zero _] at h
      exact h
    · obtain ⟨m, n, rfl, rfl, rfl⟩ := (hA _ _ _).mp h
      have h' := M.graph₂_app hA m (M.nsucc n)
      rw [M.addN_succ] at h'
      exact h'

end Model

end NFUCut



/-!
# Phase 3, part 7: the graphs of multiplication, of `2ˣ` and of `tw` are definable
-/

namespace NFUCut

namespace Model

variable {V : Type} [Nonempty V] (M : Model V) [hinf : Fact M.Infinity]

theorem graph_congr {G : V} {F H : M.Num → M.Num} (h : M.IsGraphOf G F) (e : F = H) :
    M.IsGraphOf G H := e ▸ h

/-- The specification of the graph of multiplication, given the graph `A` of addition. -/
def MulSpec (A Mu : V) : Prop :=
  (∀ a b c, M.mem (M.trip a b c) Mu → M.mem a M.nat ∧ M.mem b M.nat ∧ M.mem c M.nat) ∧
  (∀ a b, M.mem a M.nat → M.mem b M.nat → ∃ c, M.mem (M.trip a b c) Mu) ∧
  (∀ a b c c', M.mem (M.trip a b c) Mu → M.mem (M.trip a b c') Mu → c = c') ∧
  (∀ a, M.mem a M.nat → M.mem (M.trip a M.zero M.zero) Mu) ∧
  (∀ a b c, M.mem (M.trip a b c) Mu →
    ∃ c', M.mem (M.trip c a c') A ∧ M.mem (M.trip a (M.succ b) c') Mu)

theorem mulSpec_iff {A Mu : V} (hA : M.IsGraphOf₂ A M.addN) :
    M.MulSpec A Mu ↔ M.IsGraphOf₂ Mu M.mulN := by
  constructor
  · rintro ⟨hnum, htot, hfun, h0, hs⟩
    obtain ⟨F, hF⟩ := M.exists_op_of_graph hnum htot hfun
    refine M.graph₂_congr hF (M.op_unique ⟨Mu, hF⟩ M.mulN_natOp (fun a => ?_) (fun a b ih => ?_))
    · rw [show M.mulN a 0 = 0 from M.mulN_zero a]
      exact Subtype.ext (M.graph₂_val hF (n := 0) (h0 a.1 a.2)).symm
    · obtain ⟨c', h1, h2⟩ := hs _ _ _ (M.graph₂_app hF a b)
      have e1 := M.graph₂_val hA h1
      have h3 : M.mem (M.trip a.1 (b + 1 : M.Num).1 c') Mu := by
        rw [← M.nsucc_eq_add_one]
        exact h2
      have e2 := M.graph₂_val hF h3
      rw [← M.nsucc_eq_add_one, M.mulN_succ]
      refine Subtype.ext ?_
      rw [M.nsucc_eq_add_one, ← e2, e1, ih]
  · intro hMu
    refine ⟨fun a b c h => ?_, fun a b ha hb => ⟨_, M.graph₂_app hMu ⟨a, ha⟩ ⟨b, hb⟩⟩,
      fun a b c c' h h' => ?_, fun a ha => ?_, fun a b c h => ?_⟩
    · obtain ⟨m, n, rfl, rfl, rfl⟩ := (hMu _ _ _).mp h
      exact ⟨m.2, n.2, (M.mulN m n).2⟩
    · obtain ⟨m, n, rfl, rfl, rfl⟩ := (hMu _ _ _).mp h
      exact (M.graph₂_val hMu h').symm
    · have h := M.graph₂_app hMu ⟨a, ha⟩ 0
      rw [show M.mulN ⟨a, ha⟩ 0 = 0 from M.mulN_zero _] at h
      exact h
    · obtain ⟨m, n, rfl, rfl, rfl⟩ := (hMu _ _ _).mp h
      refine ⟨(M.addN (M.mulN m n) m).1, M.graph₂_app hA _ _, ?_⟩
      have h' := M.graph₂_app hMu m (M.nsucc n)
      rw [M.mulN_succ] at h'
      exact h'

/-- The specification of the graph of `2ˣ`, given the graph `A` of addition. -/
def ExpSpec (A Ex : V) : Prop :=
  (∀ a c, M.mem (M.op a c) Ex → M.mem a M.nat ∧ M.mem c M.nat) ∧
  (∀ a, M.mem a M.nat → ∃ c, M.mem (M.op a c) Ex) ∧
  (∀ a c c', M.mem (M.op a c) Ex → M.mem (M.op a c') Ex → c = c') ∧
  M.mem (M.op M.zero (M.succ M.zero)) Ex ∧
  (∀ b y, M.mem (M.op b y) Ex → ∃ y', M.mem (M.trip y y y') A ∧ M.mem (M.op (M.succ b) y') Ex)

theorem expSpec_iff {A Ex : V} (hA : M.IsGraphOf₂ A M.addN) :
    M.ExpSpec A Ex ↔ M.IsGraphOf Ex M.expN := by
  constructor
  · rintro ⟨hnum, htot, hfun, h0, hs⟩
    obtain ⟨F, hF⟩ := M.exists_fn_of_graph hnum htot hfun
    refine M.graph_congr hF (M.fn_unique ⟨Ex, hF⟩ M.natFn_expN ?_ (fun b ih => ?_))
    · rw [show M.expN 0 = 1 from M.expN_zero]
      exact Subtype.ext (M.graph_val hF (n := 0) h0).symm
    · obtain ⟨y', h1, h2⟩ := hs _ _ (M.graph_app hF b)
      have e1 := M.graph₂_val hA h1
      have h3 : M.mem (M.op (b + 1 : M.Num).1 y') Ex := by
        rw [← M.nsucc_eq_add_one]
        exact h2
      have e2 := M.graph_val hF h3
      rw [← M.nsucc_eq_add_one, M.expN_succ]
      refine Subtype.ext ?_
      rw [M.nsucc_eq_add_one, ← e2, e1, ih]
  · intro hEx
    refine ⟨fun a c h => ?_, fun a ha => ⟨_, M.graph_app hEx ⟨a, ha⟩⟩,
      fun a c c' h h' => ?_, ?_, fun b y h => ?_⟩
    · obtain ⟨m, rfl, rfl⟩ := (hEx _ _).mp h
      exact ⟨m.2, (M.expN m).2⟩
    · obtain ⟨m, rfl, rfl⟩ := (hEx _ _).mp h
      exact (M.graph_val hEx h').symm
    · have h := M.graph_app hEx 0
      rw [show M.expN 0 = 1 from M.expN_zero] at h
      exact h
    · obtain ⟨m, rfl, rfl⟩ := (hEx _ _).mp h
      refine ⟨(M.addN (M.expN m) (M.expN m)).1, M.graph₂_app hA _ _, ?_⟩
      have h' := M.graph_app hEx (M.nsucc m)
      rw [M.expN_succ] at h'
      exact h'

/-- The specification of the graph of `tw`, given the graphs of addition, multiplication and
`2ˣ`. -/
def TwSpec (A Mu Ex Tw : V) : Prop :=
  (∀ a c, M.mem (M.op a c) Tw → M.mem a M.nat ∧ M.mem c M.nat) ∧
  (∀ a, M.mem a M.nat → ∃ c, M.mem (M.op a c) Tw) ∧
  (∀ a c c', M.mem (M.op a c) Tw → M.mem (M.op a c') Tw → c = c') ∧
  M.mem (M.op M.zero M.zero) Tw ∧
  (∀ b y, M.mem (M.op b y) Tw → ∃ e1 p e2 r, M.mem (M.op (M.succ y) e1) Ex ∧
    M.mem (M.trip e1 (M.succ y) p) Mu ∧ M.mem (M.op p e2) Ex ∧ M.mem (M.trip e2 e2 r) A ∧
    M.mem (M.op (M.succ b) r) Tw)

theorem twSpec_iff {A Mu Ex Tw : V} (hA : M.IsGraphOf₂ A M.addN) (hMu : M.IsGraphOf₂ Mu M.mulN)
    (hEx : M.IsGraphOf Ex M.expN) : M.TwSpec A Mu Ex Tw ↔ M.IsGraphOf Tw M.tw := by
  have hstep : ∀ y : M.Num, Host.rstep M.expN y =
      M.addN (M.expN (M.mulN (M.expN (M.nsucc y)) (M.nsucc y)))
        (M.expN (M.mulN (M.expN (M.nsucc y)) (M.nsucc y))) := by
    intro y
    rw [M.nsucc_eq_add_one]
    rfl
  constructor
  · rintro ⟨hnum, htot, hfun, h0, hs⟩
    obtain ⟨F, hF⟩ := M.exists_fn_of_graph hnum htot hfun
    refine M.graph_congr hF (M.fn_unique ⟨Tw, hF⟩ M.natFn_tw ?_ (fun b ih => ?_))
    · rw [M.tw_zero]
      exact Subtype.ext (M.graph_val hF (n := 0) h0).symm
    · obtain ⟨e1, p, e2, r, h1, h2, h3, h4, h5⟩ := hs _ _ (M.graph_app hF b)
      have a1 := M.graph_val hEx (n := M.nsucc (F b)) h1
      rw [a1] at h2
      have a2 := M.graph₂_val hMu (m := M.expN (M.nsucc (F b))) (n := M.nsucc (F b)) h2
      rw [a2] at h3
      have a3 := M.graph_val hEx h3
      rw [a3] at h4
      have a4 := M.graph₂_val hA h4
      have h6 : M.mem (M.op (b + 1 : M.Num).1 r) Tw := by
        rw [← M.nsucc_eq_add_one]
        exact h5
      have a5 := M.graph_val hF h6
      rw [M.tw_succ, hstep, ← ih]
      exact Subtype.ext (a5.symm.trans a4)
  · intro hTw
    refine ⟨fun a c h => ?_, fun a ha => ⟨_, M.graph_app hTw ⟨a, ha⟩⟩,
      fun a c c' h h' => ?_, ?_, fun b y h => ?_⟩
    · obtain ⟨m, rfl, rfl⟩ := (hTw _ _).mp h
      exact ⟨m.2, (M.tw m).2⟩
    · obtain ⟨m, rfl, rfl⟩ := (hTw _ _).mp h
      exact (M.graph_val hTw h').symm
    · have h := M.graph_app hTw 0
      rw [M.tw_zero] at h
      exact h
    · obtain ⟨m, rfl, rfl⟩ := (hTw _ _).mp h
      refine ⟨_, _, _, _, M.graph_app hEx (M.nsucc (M.tw m)),
        M.graph₂_app hMu (M.expN (M.nsucc (M.tw m))) (M.nsucc (M.tw m)),
        M.graph_app hEx _, M.graph₂_app hA _ _, ?_⟩
      have h' := M.graph_app hTw (m + 1)
      rw [M.tw_succ, hstep, ← M.nsucc_eq_add_one] at h'
      exact h'

end Model

end NFUCut



/-!
# Phase 3, part 8: the formulas that characterise the parameters

Names: `1` zero, `2` the set of natural numbers, `3` the graph of `+`, `4` the graph of `·`,
`5` one, `6` the graph of `tw`, `7` the graph of `2ˣ`. Bound names `8`–`18` and `26`–`29`.
-/

namespace NFUCut

open Model in
/-- "`1` is zero." -/
def isZ : Fml := Fml.ex 8 (.and (.and (.set 8) (.all 9 (.neg (.mem 9 8)))) (fSing 1 8 9))

open Model in
/-- "`5` is the successor of `1`." -/
def isOne : Fml := fSucc 5 1 26 27 28 29

open Model in
/-- "`2` is the set of the natural numbers." -/
def isNat : Fml :=
  .and (.set 2) (.all 8 (Fml.iff (.mem 8 2) (.all 9 (Fml.imp
    (.and (.mem 1 9) (.all 10 (Fml.imp (.mem 10 9) (Fml.ex 11 (.and (.mem 11 9)
      (fSucc 11 10 26 27 28 29)))))) (.mem 8 9)))))

open Model in
/-- The members of the set of triples `G` have numbers as components; `G` is total and
functional. -/
def fGraph3 (G : ℕ) : Fml :=
  .and (.all 8 (.all 9 (.all 10 (Fml.imp (fApp3 G 8 9 10)
      (.and (.mem 8 2) (.and (.mem 9 2) (.mem 10 2)))))))
    (.and (.all 8 (.all 9 (Fml.imp (.and (.mem 8 2) (.mem 9 2)) (Fml.ex 10 (fApp3 G 8 9 10)))))
      (.all 8 (.all 9 (.all 10 (.all 11 (Fml.imp (.and (fApp3 G 8 9 10) (fApp3 G 8 9 11))
        (.eq 10 11)))))))

open Model in
/-- The same for a set of pairs. -/
def fGraph2 (G : ℕ) : Fml :=
  .and (.all 8 (.all 10 (Fml.imp (fApp G 8 10) (.and (.mem 8 2) (.mem 10 2)))))
    (.and (.all 8 (Fml.imp (.mem 8 2) (Fml.ex 10 (fApp G 8 10))))
      (.all 8 (.all 10 (.all 11 (Fml.imp (.and (fApp G 8 10) (fApp G 8 11)) (.eq 10 11))))))

open Model in
def fAddSpec : Fml :=
  .and (fGraph3 3) (.and (.all 8 (Fml.imp (.mem 8 2) (fApp3 3 8 1 8)))
    (.all 8 (.all 9 (.all 10 (Fml.imp (fApp3 3 8 9 10) (Fml.ex 12 (.and (fSucc 12 9 26 27 28 29)
      (Fml.ex 13 (.and (fSucc 13 10 26 27 28 29) (fApp3 3 8 12 13))))))))))

open Model in
def fMulSpec : Fml :=
  .and (fGraph3 4) (.and (.all 8 (Fml.imp (.mem 8 2) (fApp3 4 8 1 1)))
    (.all 8 (.all 9 (.all 10 (Fml.imp (fApp3 4 8 9 10) (Fml.ex 11 (.and (fApp3 3 10 8 11)
      (Fml.ex 12 (.and (fSucc 12 9 26 27 28 29) (fApp3 4 8 12 11))))))))))

open Model in
def fExpSpec : Fml :=
  .and (fGraph2 7) (.and (Fml.ex 12 (.and (fSucc 12 1 26 27 28 29) (fApp 7 1 12)))
    (.all 9 (.all 10 (Fml.imp (fApp 7 9 10) (Fml.ex 11 (.and (fApp3 3 10 10 11)
      (Fml.ex 12 (.and (fSucc 12 9 26 27 28 29) (fApp 7 12 11)))))))))

open Model in
def fTwSpec : Fml :=
  .and (fGraph2 6) (.and (fApp 6 1 1)
    (.all 9 (.all 10 (Fml.imp (fApp 6 9 10) (Fml.ex 18 (.and (fSucc 18 10 26 27 28 29)
      (Fml.ex 14 (Fml.ex 15 (Fml.ex 16 (Fml.ex 17 (.and (fApp 7 18 14) (.and (fApp3 4 14 18 15)
        (.and (fApp 7 15 16) (.and (fApp3 3 16 16 17) (Fml.ex 12 (.and (fSucc 12 9 26 27 28 29)
          (fApp 6 12 17)))))))))))))))))

namespace Model

variable {V : Type} [Nonempty V] (M : Model V) [hinf : Fact M.Infinity]

theorem sat_isZ (ρ : ℕ → V) : Sat M.mem M.isSet isZ ρ ↔ ρ 1 = M.zero := by
  unfold isZ
  simp only [M.sat_ex, Sat, M.sat_fSing (u := 1) (a := 8) (c := 9) (by decide) (by decide),
    Function.update_self, Function.update_of_ne (show (1 : ℕ) ≠ 8 by decide),
    Function.update_of_ne (show (8 : ℕ) ≠ 9 by decide)]
  constructor
  · rintro ⟨e, ⟨he1, he2⟩, h⟩
    rw [h, M.eq_emp he1 he2]
    rfl
  · intro h
    exact ⟨M.emp, ⟨M.emp_isSet, M.not_mem_emp⟩, h⟩

theorem sat_isOne (ρ : ℕ → V) : Sat M.mem M.isSet isOne ρ ↔ ρ 5 = M.succ (ρ 1) :=
  M.sat_fSucc (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) ρ

theorem sat_isNat (ρ : ℕ → V) (h1 : ρ 1 = M.zero) : Sat M.mem M.isSet isNat ρ ↔ ρ 2 = M.nat := by
  have key : ∀ n : V, (Sat M.mem M.isSet (.all 9 (Fml.imp
      (.and (.mem 1 9) (.all 10 (Fml.imp (.mem 10 9) (Fml.ex 11 (.and (.mem 11 9)
        (fSucc 11 10 26 27 28 29)))))) (.mem 8 9))) (Function.update ρ 8 n) ↔ M.mem n M.nat) := by
    intro n
    rw [M.mem_nat]
    simp [Sat, M.sat_imp, M.sat_ex, M.sat_fSucc (s := 11) (k := 10) (y := 26) (x := 27) (b := 28)
      (z := 29) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
      (by decide) (by decide) (by decide) (by decide), Function.update_apply, h1]
  unfold isNat
  simp only [Sat, M.sat_iff, Function.update_self,
    Function.update_of_ne (show (2 : ℕ) ≠ 8 by decide)]
  constructor
  · rintro ⟨hs, h⟩
    exact M.ext hs (Classical.choose_spec M.exists_nat).1 fun n => (h n).trans (key n)
  · intro h
    rw [h]
    exact ⟨(Classical.choose_spec M.exists_nat).1, fun n => (key n).symm⟩

end Model

end NFUCut



/-!
# Phase 3, part 9: the specification formulas say what they should
-/

namespace NFUCut

