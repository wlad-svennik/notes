theorem NF210.Proof.BusyBeaver.busyBeaver210_exactValue_independent : NF210.Proof.NFSecond.ArithmeticSigmaOneSound →
  FFL.Entailment.Independent NF210.Proof.NF (NF210.Proof.BusyBeaver.nfExactValue (NF210.TM.busyBeaver 210)) :=
fun sound =>
  let this := sound;
  have consistent := NF210.Proof.ArithmeticPullback.conNF_of_consistent inferInstance;
  ⟨NF210.Proof.BusyBeaver.no_numeral_exact_value consistent (NF210.TM.busyBeaver 210),
    NF210.Proof.BusyBeaver.busyBeaver210_exactValue_unrefutable sound⟩
