theorem NF210.Proof.BusyBeaver.no_numeral_exact_value : NF210.Proof.ConNF →
  ∀ (k : ℕ), NF210.Proof.NF ⊬ NF210.Proof.BusyBeaver.nfExactValue k :=
fun consistent k proof =>
  NF210.Proof.BusyBeaver.no_numeral_upper_bound consistent k
